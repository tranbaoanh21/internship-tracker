{
  "openapi": "3.1.0",
  "info": {
    "title": "Internship Application Tracker API",
    "version": "2.0.0",
    "summary": "REST API for managing an internship application pipeline",
    "description": "Authenticated single-owner API with ownership isolation, follow-up planning, status history, archive/restore, optimistic concurrency, durable reminders, and server-sent notification events. JSON fields use camelCase while MySQL columns use snake_case."
  },
  "servers": [
    {
      "url": "/api",
      "description": "Current origin"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Public readiness endpoint"
    },
    {
      "name": "Authentication",
      "description": "Server-side owner session lifecycle"
    },
    {
      "name": "Applications",
      "description": "Owner-scoped application pipeline"
    },
    {
      "name": "Notifications",
      "description": "Durable follow-up reminders and realtime signals"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Check API and database health",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "API and database are ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUp"
                }
              }
            }
          },
          "503": {
            "description": "API is running but the database is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDown"
                }
              }
            }
          }
        }
      }
    },
    "/auth/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Read the current owner session",
        "description": "Returns authenticated false when no valid session exists. Responses are never cached.",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Current session state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "Create a server-side owner session",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated session and CSRF token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "Delete the current server-side session",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/applications": {
      "get": {
        "operationId": "listApplications",
        "summary": "List applications",
        "description": "Searches company and position, combines lifecycle and follow-up filters, and paginates on the server.",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchQuery"
          },
          {
            "$ref": "#/components/parameters/StatusQuery"
          },
          {
            "$ref": "#/components/parameters/AttentionQuery"
          },
          {
            "$ref": "#/components/parameters/SortQuery"
          },
          {
            "$ref": "#/components/parameters/DirectionQuery"
          },
          {
            "$ref": "#/components/parameters/ViewQuery"
          },
          {
            "$ref": "#/components/parameters/PageQuery"
          },
          {
            "$ref": "#/components/parameters/LimitQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated applications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      },
      "post": {
        "operationId": "createApplication",
        "summary": "Create an application and its initial status-history entry",
        "tags": [
          "Applications"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationCreateInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created",
            "headers": {
              "Location": {
                "description": "Relative application URL",
                "schema": {
                  "type": "string",
                  "example": "/api/applications/42"
                }
              },
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/applications/stats": {
      "get": {
        "operationId": "getApplicationStats",
        "summary": "Get contextual counts by status",
        "description": "Applies search and active/archive view, but deliberately ignores the selected status so every status bucket remains useful.",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SearchQuery"
          },
          {
            "$ref": "#/components/parameters/ViewQuery"
          }
        ],
        "responses": {
          "200": {
            "description": "All five status buckets and total",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/applications/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ApplicationId"
        }
      ],
      "get": {
        "operationId": "getApplication",
        "summary": "Get one active or archived application",
        "tags": [
          "Applications"
        ],
        "responses": {
          "200": {
            "description": "Application found",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      },
      "patch": {
        "operationId": "updateApplication",
        "summary": "Update supplied fields on an active application",
        "description": "Requires the current version through If-Match. A real status change and the application update commit in one transaction.",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationPatchInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application updated",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ]
      },
      "delete": {
        "operationId": "deleteApplication",
        "summary": "Permanently delete an archived application",
        "tags": [
          "Applications"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "204": {
            "description": "Application and status history deleted"
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/applications/{id}/history": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ApplicationId"
        }
      ],
      "get": {
        "operationId": "getApplicationHistory",
        "summary": "Get status history newest first",
        "tags": [
          "Applications"
        ],
        "responses": {
          "200": {
            "description": "Status history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": []
          }
        ]
      }
    },
    "/applications/{id}/archive": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ApplicationId"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "post": {
        "operationId": "archiveApplication",
        "summary": "Archive an active application",
        "tags": [
          "Applications"
        ],
        "responses": {
          "200": {
            "description": "Application archived",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/applications/{id}/restore": {
      "parameters": [
        {
          "$ref": "#/components/parameters/ApplicationId"
        },
        {
          "$ref": "#/components/parameters/IfMatch"
        }
      ],
      "post": {
        "operationId": "restoreApplication",
        "summary": "Restore an archived application",
        "tags": [
          "Applications"
        ],
        "responses": {
          "200": {
            "description": "Application restored",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/VersionEtag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "428": {
            "$ref": "#/components/responses/PreconditionRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        },
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ]
      }
    },
    "/notifications": {
      "get": {
        "operationId": "listNotifications",
        "summary": "List the latest follow-up notifications",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notifications and unread count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/notifications/read-all": {
      "patch": {
        "operationId": "markAllNotificationsRead",
        "summary": "Mark every owner notification read",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "responses": {
          "200": {
            "description": "Number of notifications updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarkAllReadResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/notifications/{id}/read": {
      "patch": {
        "operationId": "markNotificationRead",
        "summary": "Mark one owner notification read",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "sessionCookie": [],
            "csrfHeader": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9]\\d*$",
              "maxLength": 20
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Notification marked read"
          },
          "400": {
            "$ref": "#/components/responses/InvalidId"
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "403": {
            "$ref": "#/components/responses/CsrfInvalid"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/notifications/events": {
      "get": {
        "operationId": "streamNotifications",
        "summary": "Stream notification-change signals over SSE",
        "description": "Long-lived text/event-stream. A notification event tells the client to refetch durable notifications from MySQL.",
        "tags": [
          "Notifications"
        ],
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Server-sent event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AuthenticationRequired"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "VersionEtag": {
        "description": "Strong ETag containing the current optimistic-concurrency version",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9]\\d*\"$",
          "example": "\"3\""
        }
      }
    },
    "parameters": {
      "ApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Positive unsigned BIGINT as a decimal string",
        "schema": {
          "type": "string",
          "pattern": "^[1-9]\\d*$",
          "maxLength": 20,
          "example": "42"
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "Quoted application version returned by the previous response",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9]\\d*\"$",
          "example": "\"3\""
        }
      },
      "SearchQuery": {
        "name": "q",
        "in": "query",
        "description": "Case-insensitive company or position search",
        "schema": {
          "type": "string",
          "maxLength": 120,
          "default": ""
        }
      },
      "StatusQuery": {
        "name": "status",
        "in": "query",
        "description": "Exact status filter",
        "schema": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/ApplicationStatus"
            },
            {
              "type": "string",
              "const": ""
            }
          ],
          "default": ""
        }
      },
      "AttentionQuery": {
        "name": "attention",
        "in": "query",
        "description": "Follow-up date relative to APP_TIMEZONE",
        "schema": {
          "type": "string",
          "enum": [
            "",
            "overdue",
            "today",
            "next7",
            "none"
          ],
          "default": ""
        }
      },
      "SortQuery": {
        "name": "sort",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "updatedAt",
            "followUpAt",
            "appliedAt",
            "company"
          ],
          "default": "updatedAt"
        }
      },
      "DirectionQuery": {
        "name": "direction",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "desc"
        }
      },
      "ViewQuery": {
        "name": "view",
        "in": "query",
        "description": "Active records are the default; archived records are a separate recoverable view",
        "schema": {
          "type": "string",
          "enum": [
            "active",
            "archived"
          ],
          "default": "active"
        }
      },
      "PageQuery": {
        "name": "page",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1
        }
      },
      "LimitQuery": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "schemas": {
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "wishlist",
          "applied",
          "interview",
          "offer",
          "rejected"
        ]
      },
      "DatabaseTimestamp": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}$",
        "description": "MySQL TIMESTAMP(3) string in the database session timezone",
        "example": "2026-08-13 09:28:28.123"
      },
      "Application": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "company",
          "position",
