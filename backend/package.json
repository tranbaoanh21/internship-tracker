    "express": "5.2.1",
    "mysql2": "3.23.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
