{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node scripts/start.js",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.unit.config.js",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:watch": "vitest",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "owner:bootstrap": "node scripts/bootstrap-owner.js",
    "worker:reminders": "node scripts/reminder-worker.js",
    "reminders:scan": "node scripts/scan-reminders.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "bullmq": "6.1.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mysql2": "3.23.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "supertest": "7.2.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
