{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node scripts/start.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.js",
    "test:watch": "vitest",
